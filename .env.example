# Provider credentials the core reads at startup.
# Copy to .env and fill in. Never commit .env.

# MiniMax (https://api.minimax.io) -- OpenAI-compatible at /v1, Anthropic-compatible
# at /anthropic. Models: MiniMax-M2, M2.1, M2.5, M2.7, M2.7-highspeed, M3.
MINIMAX_API_KEY=

# Others the provider registry knows about, all optional:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
